APP_NAME="IZBORI.RS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Admin (Filament) renders in Serbian Latin; the public SPA has its own toggle.
APP_LOCALE=sr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sr_RS

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default: SQLite — one file at database/database.sqlite, zero config.
# Production: PostgreSQL (DB_CONNECTION=pgsql + DB_* below).
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=izbori
# DB_USERNAME=izbori
# DB_PASSWORD=

# Admin panel URL segment — random slug per deployment (e.g. rik-x7k2p9).
ADMIN_PATH=admin

# Seeded administrator (change the password right after first login).
SEED_ADMIN_NAME="RIK Admin"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_STAGE=final

# --- Snapshots (published JSON the public site reads) ---
# Filesystem disk that holds /data (config/filesystems.php). Local default = public/data.
SNAPSHOT_DISK=snapshots
# Base URL the SPA uses for data files. Point at a CDN in production.
SNAPSHOT_PUBLIC_URL=/data
# Keep only the newest N versions per source on disk (0 = keep all, recommended for audit).
SNAPSHOT_KEEP_VERSIONS=0
# Results republish cadence while an election is in "counting" (minutes).
PUBLISH_INTERVAL_MINUTES=2
# A race counts as "close" within this many percentage points.
CLOSE_RACE_MARGIN_PCT=1.0

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="izbori@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
